rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberOf(tid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/shared/$(tid)).data.memberUids;
    }
    // Each person's own data: a profile doc plus one collection per data type
    // (users/{uid}/expenses, /trips, /flights, ...). Only that Google account can read or write it.
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{section}/{id} {
        allow read, write: if isOwner(uid);
      }
    }
    match /shared/{tid} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.resource.data.memberUids == [request.auth.uid];
      // Members edit freely. Anyone holding the invite link may only add themselves.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids));
      match /{sub}/{id} {
        allow read, write: if memberOf(tid);
      }
    }
  }
}
